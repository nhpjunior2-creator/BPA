rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify if user owns the document path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Connection testing endpoint
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /atendimentos/{atendimentoId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /config/{configId} {
        allow read, write: if isOwner(userId);
      }

      match /sync_metadata/{metaId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
